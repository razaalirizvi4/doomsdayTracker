# Resend — get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# From address (must be from a Resend-verified domain)
FROM_EMAIL=noreply@yourdomain.com

# Secret to verify Vercel Cron requests (generate with: openssl rand -hex 32)
CRON_SECRET=your-random-secret-here

# Secret for HMAC unsubscribe tokens
UNSUBSCRIBE_SECRET=another-random-secret-here

# Your deployed URL (used in unsubscribe links)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Upstash Redis — auto-populated when you add the Upstash Redis integration in Vercel
# https://vercel.com/marketplace?category=storage&search=redis
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx
